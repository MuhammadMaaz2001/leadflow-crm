{
  "name": "@leadflow/database",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy && tsx scripts/set-role-passwords.ts",
    "migrate:dev": "prisma migrate dev",
    "reset": "prisma migrate reset --force --skip-seed && tsx scripts/set-role-passwords.ts",
    "build": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.10.0"
  }
}
