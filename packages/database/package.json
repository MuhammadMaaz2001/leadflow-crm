{
  "name": "@leadflow/database",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy && tsx scripts/set-role-passwords.ts",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx src/seed.ts",
    "reset": "prisma migrate reset --force --skip-seed && tsx src/seed.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
