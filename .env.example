# ── LeadFlow CRM environment (copy to .env). DEVELOPMENT VALUES ONLY — never reuse in production ──
# NODE_ENV is intentionally not set here: the API defaults to development; set NODE_ENV=production only when deploying.

# Owner/migration connection (runs migrations & seed; superuser in dev)
DATABASE_URL=postgresql://leadflow:leadflow_dev@localhost:5432/leadflow
# Runtime connections. The API connects as a restricted role subject to row level security.
APP_DATABASE_URL=postgresql://leadflow_app:leadflow_app_dev@localhost:5432/leadflow?connection_limit=20
# Platform-admin connection: BYPASSRLS but table grants exclude all private lead/CRM data.
PLATFORM_DATABASE_URL=postgresql://leadflow_platform:leadflow_platform_dev@localhost:5432/leadflow?connection_limit=5
# Passwords applied to the roles above by `npm run db:migrate` (scripts/set-role-passwords)
APP_DB_PASSWORD=leadflow_app_dev
PLATFORM_DB_PASSWORD=leadflow_platform_dev

REDIS_URL=redis://localhost:6379
# Run jobs inline (no worker process needed). Set false and run `npm run dev:worker -w @leadflow/api` for BullMQ.
JOBS_INLINE=false

API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
SESSION_COOKIE_NAME=lf_session
SESSION_TTL_DAYS=14
# Development email transport persists messages to /dev/mailbox instead of sending SMTP mail.
EMAIL_TRANSPORT=dev

# ── Optional / production-related settings (see ENVIRONMENT_SETUP.md; deploy/api.env.example is the production template) ──
# SLOW_QUERY_MS=500            # log slow SQL (parameterised text only)
# LOG_LEVEL=info
# RATE_LIMIT_STORE=redis       # redis (shared across instances) | memory
# EMAIL_TRANSPORT=dev          # dev | smtp | none   (production requires smtp)
# STORAGE_PROVIDER=db          # db | s3
# PAYMENT_PROVIDER=manual
