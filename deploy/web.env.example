# ── LeadFlow web (Next.js) — build-time / runtime settings. No secrets belong here: the browser bundle must never contain any. ──
NODE_ENV=production
API_URL=https://api.example.com        # BUILD-TIME: target of the /api/* rewrite (the browser only ever talks to the web origin)
CSP_UPGRADE_INSECURE_REQUESTS=true     # adds `upgrade-insecure-requests` to the Content-Security-Policy once the site is served over https
PORT=3000
