# ── LeadFlow API + worker — PRODUCTION TEMPLATE. Every value below is a placeholder: set real values in your platform's secret manager. ──
# Never commit a filled-in copy of this file. Validate before every deploy:  NODE_ENV=production npm run check:config
NODE_ENV=production
SERVICE_NAME=leadflow-api
LOG_LEVEL=info
SLOW_QUERY_MS=500

# Public URLs. WEB_URL = browser origin(s), https only, comma separated (CORS + CSRF origin check). API_URL = this API's public base URL.
WEB_URL=https://app.example.com
API_URL=https://api.example.com
API_PORT=4000
TRUST_PROXY=1                      # number of reverse-proxy hops in front of the API (client IP for rate limiting)

# PostgreSQL (managed). Three different roles — see DEPLOYMENT.md §3.
DATABASE_URL=postgresql://OWNER_USER:CHANGE_ME@db.example.internal:5432/leadflow?sslmode=require          # migrations only (not used by the running API)
APP_DATABASE_URL=postgresql://leadflow_app:CHANGE_ME@db.example.internal:5432/leadflow?sslmode=require     # runtime, row level security applies
PLATFORM_DATABASE_URL=postgresql://leadflow_platform:CHANGE_ME@db.example.internal:5432/leadflow?sslmode=require
APP_DB_PASSWORD=CHANGE_ME           # applied to the roles by the migration job
PLATFORM_DB_PASSWORD=CHANGE_ME
DB_POOL_MAX=20                      # per API instance: instances × (DB_POOL_MAX + DB_PLATFORM_POOL_MAX) must stay below max_connections
DB_PLATFORM_POOL_MAX=5

# Redis (managed, TLS): rate limiting, scheduler lock, BullMQ
REDIS_URL=rediss://default:CHANGE_ME@redis.example.internal:6379
RATE_LIMIT_STORE=redis
JOBS_INLINE=false

# Sessions
SESSION_TTL_DAYS=14
SESSION_IDLE_DAYS=7

# Email (SMTP provider of your choice)
EMAIL_TRANSPORT=smtp
EMAIL_FROM="LeadFlow <hello@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# Object storage (S3-compatible). Keep the bucket PRIVATE; the API serves objects to authenticated members only.
STORAGE_PROVIDER=s3
S3_BUCKET=leadflow-assets
S3_REGION=us-east-1
S3_ENDPOINT=                        # empty for AWS S3; set for R2 / MinIO / B2 …
S3_FORCE_PATH_STYLE=false           # true for MinIO
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

PAYMENT_PROVIDER=manual             # only "manual" exists: invoices are settled by a platform billing admin

# Optional
# ERROR_WEBHOOK_URL=https://errors.example.com/ingest    # receives redacted JSON error events
# API_DOCS=true                                          # expose Swagger UI + /api/openapi.json (off by default in production)

# Worker only
WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=4001
SHUTDOWN_TIMEOUT_MS=25000
